DB_FILE=./data/support.db

PORT=3000
# 127.0.0.1 = only you. Use 0.0.0.0 to open it to the network (there is no login).
HOST=127.0.0.1

# Pre-filled in the "Responsed By" field and the default person in reports.
# Must match the name in your sheet (case does not matter).
DEFAULT_RESPONDER=Vibhas Pandey
# Used for the "share of the week lost to support" bar
WORKDAY_HOURS=8


